# AGENT_TIMEOUT_CLAUDE_POST_IMPL_RETRY="${AGENT_TIMEOUT_CLAUDE_POST_IMPL_RETRY:-}"
# AGENT_BUDGET_USD_CLAUDE_POST_IMPL_RETRY="${AGENT_BUDGET_USD_CLAUDE_POST_IMPL_RETRY:-}"
# AGENT_PERMISSION_MODE_CLAUDE_POST_IMPL_RETRY="${AGENT_PERMISSION_MODE_CLAUDE_POST_IMPL_RETRY:-}"
# AGENT_MAX_TURNS_CLAUDE_POST_IMPL_RETRY="${AGENT_MAX_TURNS_CLAUDE_POST_IMPL_RETRY:-}"
# AGENT_MODEL_CODEX_POST_IMPL_RETRY="${AGENT_MODEL_CODEX_POST_IMPL_RETRY:-}"
# AGENT_EFFORT_CODEX_POST_IMPL_RETRY="${AGENT_EFFORT_CODEX_POST_IMPL_RETRY:-}"
