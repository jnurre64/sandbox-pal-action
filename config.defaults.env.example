# ╔══════════════════════════════════════════════════════════════╗
# ║  Claude Agent Dispatch — Project Defaults                  ║
# ║  Copy to .sandbox-pal-dispatch/config.defaults.env (standalone)  ║
# ║  or ~/agent-infra/config.defaults.env (reference mode)     ║
# ║                                                            ║
# ║  ⚠  This file is COMMITTED to the repository.              ║
# ║     Do NOT put secrets, tokens, or credentials here.       ║
# ║     Use config.env for sensitive overrides (gitignored).   ║
# ║                                                            ║
# ║  ⚠  All assignments below use the ${VAR:-default} form so  ║
# ║     that workflow env: blocks and config.env overrides are ║
# ║     preserved. Plain `VAR=value` would overwrite them.     ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Required ─────────────────────────────────────────────────
# GitHub bot account username (the account that will comment, push, create PRs)
AGENT_BOT_USER="${AGENT_BOT_USER:-}"

# ── Optional (defaults shown) ────────────────────────────────
# Worker selection: Claude remains default; Codex and mixed phases are opt-in.
# Keep these in the shared config file so label and programmatic events agree.
# AGENT_ENGINE="${AGENT_ENGINE:-claude}"
# AGENT_MODEL_CLAUDE="${AGENT_MODEL_CLAUDE:-}"
# AGENT_MODEL_CODEX="${AGENT_MODEL_CODEX:-}"
# Routing overrides win. Unqualified phase models use legacy precedence unless
# engine profiles below are enabled (then they are Claude-only fallbacks).
# AGENT_ENGINE_TRIAGE="${AGENT_ENGINE_TRIAGE:-}"
# AGENT_MODEL_TRIAGE="${AGENT_MODEL_TRIAGE:-}"
# AGENT_ENGINE_REPLY="${AGENT_ENGINE_REPLY:-}"
# AGENT_MODEL_REPLY="${AGENT_MODEL_REPLY:-}"
# AGENT_ENGINE_VALIDATE="${AGENT_ENGINE_VALIDATE:-}"
# AGENT_MODEL_VALIDATE="${AGENT_MODEL_VALIDATE:-}"
# AGENT_ENGINE_IMPLEMENT="${AGENT_ENGINE_IMPLEMENT:-}"
# AGENT_MODEL_IMPLEMENT="${AGENT_MODEL_IMPLEMENT:-}"
# AGENT_ENGINE_REVIEW="${AGENT_ENGINE_REVIEW:-}"
# AGENT_MODEL_REVIEW="${AGENT_MODEL_REVIEW:-}"
# AGENT_ENGINE_ADVERSARIAL_PLAN="${AGENT_ENGINE_ADVERSARIAL_PLAN:-}"
# AGENT_MODEL_ADVERSARIAL_PLAN="${AGENT_MODEL_ADVERSARIAL_PLAN:-}"
# AGENT_ENGINE_POST_IMPL_REVIEW="${AGENT_ENGINE_POST_IMPL_REVIEW:-}"
# AGENT_MODEL_POST_IMPL_REVIEW="${AGENT_MODEL_POST_IMPL_REVIEW:-}"
# AGENT_ENGINE_POST_IMPL_RETRY="${AGENT_ENGINE_POST_IMPL_RETRY:-}"
# AGENT_MODEL_POST_IMPL_RETRY="${AGENT_MODEL_POST_IMPL_RETRY:-}"
# AGENT_ENGINE_TEST_FIX="${AGENT_ENGINE_TEST_FIX:-}"
# AGENT_MODEL_TEST_FIX="${AGENT_MODEL_TEST_FIX:-}"
# AGENT_ENGINE_CLEANUP="${AGENT_ENGINE_CLEANUP:-}"
# AGENT_MODEL_CLEANUP="${AGENT_MODEL_CLEANUP:-}"

# ── Retain both engines' settings (one-time opt-in) ──────────────
# See docs/configuration.md#retain-both-engines-settings for adoption and examples.
# These are project setting groups, not Codex CLI permission profiles.
# Update/setup never enable this automatically. Before enabling, migrate any
# unqualified Codex model/effort values to the CODEX namespace. Legacy controls
# become Claude-only fallbacks, except AGENT_TIMEOUT remains shared.
# AGENT_ENGINE_PROFILES="${AGENT_ENGINE_PROFILES:-false}"
# Engine+phase > engine default > Claude legacy fallback > harness/CLI default.
# Empty entries inherit. Nonempty false/0 values are validated, not discarded.
# MODEL_CLAUDE and MODEL_CODEX defaults are listed under Worker selection above.
# AGENT_EFFORT_CLAUDE="${AGENT_EFFORT_CLAUDE:-}"
# AGENT_TIMEOUT_CLAUDE="${AGENT_TIMEOUT_CLAUDE:-}"
