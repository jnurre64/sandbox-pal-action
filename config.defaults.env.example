# TEST_FIX
# AGENT_MODEL_CLAUDE_TEST_FIX="${AGENT_MODEL_CLAUDE_TEST_FIX:-}"
# AGENT_EFFORT_CLAUDE_TEST_FIX="${AGENT_EFFORT_CLAUDE_TEST_FIX:-}"
# AGENT_TIMEOUT_CLAUDE_TEST_FIX="${AGENT_TIMEOUT_CLAUDE_TEST_FIX:-}"
# AGENT_BUDGET_USD_CLAUDE_TEST_FIX="${AGENT_BUDGET_USD_CLAUDE_TEST_FIX:-}"
# AGENT_PERMISSION_MODE_CLAUDE_TEST_FIX="${AGENT_PERMISSION_MODE_CLAUDE_TEST_FIX:-}"
# AGENT_MAX_TURNS_CLAUDE_TEST_FIX="${AGENT_MAX_TURNS_CLAUDE_TEST_FIX:-}"
# AGENT_MODEL_CODEX_TEST_FIX="${AGENT_MODEL_CODEX_TEST_FIX:-}"
# AGENT_EFFORT_CODEX_TEST_FIX="${AGENT_EFFORT_CODEX_TEST_FIX:-}"
# AGENT_TIMEOUT_CODEX_TEST_FIX="${AGENT_TIMEOUT_CODEX_TEST_FIX:-}"
# CLEANUP
# AGENT_MODEL_CLAUDE_CLEANUP="${AGENT_MODEL_CLAUDE_CLEANUP:-}"
# AGENT_EFFORT_CLAUDE_CLEANUP="${AGENT_EFFORT_CLAUDE_CLEANUP:-}"
# AGENT_TIMEOUT_CLAUDE_CLEANUP="${AGENT_TIMEOUT_CLAUDE_CLEANUP:-}"
# AGENT_BUDGET_USD_CLAUDE_CLEANUP="${AGENT_BUDGET_USD_CLAUDE_CLEANUP:-}"
# AGENT_PERMISSION_MODE_CLAUDE_CLEANUP="${AGENT_PERMISSION_MODE_CLAUDE_CLEANUP:-}"
# AGENT_MAX_TURNS_CLAUDE_CLEANUP="${AGENT_MAX_TURNS_CLAUDE_CLEANUP:-}"
# AGENT_MODEL_CODEX_CLEANUP="${AGENT_MODEL_CODEX_CLEANUP:-}"
# AGENT_EFFORT_CODEX_CLEANUP="${AGENT_EFFORT_CODEX_CLEANUP:-}"
# AGENT_TIMEOUT_CODEX_CLEANUP="${AGENT_TIMEOUT_CODEX_CLEANUP:-}"
# Do not assign budgets, turns, permission modes, tools or MCP controls to CODEX:
# explicit unsupported CODEX assignments (even empty) fail for reachable phases.
# Keep existing tool/label-tool/MCP controls as Claude-only settings.

# Max Claude conversation turns per invocation
AGENT_MAX_TURNS="${AGENT_MAX_TURNS:-200}"

# Codex uses native policy by default instead of applying
# Claude tool lists (including label tools), MCP settings and turn caps to Codex.
# Native research/integrations retain their existing Codex configuration.
# Select Codex with AGENT_ENGINE or a phase override; this setting alone does not.
# Without profiles, shared dollar budgets/permission modes fail on Codex phases.
# With profiles, these are Claude-only; explicit CODEX controls still fail.
# AGENT_CODEX_USE_NATIVE_POLICY="${AGENT_CODEX_USE_NATIVE_POLICY:-true}"

# Shared fallback invocation timeout in seconds for either engine.
# The outer GitHub job/session deadline can terminate a worker earlier.
AGENT_TIMEOUT="${AGENT_TIMEOUT:-3600}"

# Circuit breaker: max bot comments per hour per issue
AGENT_CIRCUIT_BREAKER_LIMIT="${AGENT_CIRCUIT_BREAKER_LIMIT:-8}"

# Path to shared Claude memory file (optional, enhances agent context)
# AGENT_MEMORY_FILE="${AGENT_MEMORY_FILE:-}"

# Shared memory directory: index + the files its pointers name; phases
# can Read them (read-only). Use for ~/.claude/projects/<slug>/memory/.
# AGENT_MEMORY_DIR="${AGENT_MEMORY_DIR:-}"

# Per-phase invocation flags — all optional, defaults preserve current
# behaviour. Budget is LIMITLESS unless set. Suffixes: TRIAGE, REPLY,
# IMPLEMENT, VALIDATE, REVIEW, CLEANUP, ADVERSARIAL_PLAN, TEST_FIX,
# POST_IMPL_REVIEW, POST_IMPL_RETRY.
# AGENT_BUDGET_USD="${AGENT_BUDGET_USD:-}"
# AGENT_BUDGET_USD_IMPLEMENT="80"
# AGENT_EFFORT_IMPLEMENT="xhigh"
# AGENT_PERMISSION_MODE_TRIAGE="dontAsk"
# AGENT_MCP_CONFIG="${AGENT_MCP_CONFIG:-}"
# AGENT_STRICT_MCP="${AGENT_STRICT_MCP:-}"
# AGENT_SESSION_PERSISTENCE="${AGENT_SESSION_PERSISTENCE:-false}"

# Headless controls for Claude phases.
# Permission prompts: "none" means anything that would prompt is denied at once
# and reported, since nobody can answer a prompt in a headless phase. "host"
# hands prompts to an SDK host. A plain AGENT_PERMISSION_PROMPTS="" omits the
# flag. It is only passed to a CLI whose --help lists it.
# AGENT_PERMISSION_PROMPTS="${AGENT_PERMISSION_PROMPTS:-none}"
# Background-wait ceiling in milliseconds: how long a phase waits for its own
# background work before it returns. Keep it well under AGENT_TIMEOUT. A plain
# empty value leaves the CLI's own ceiling in place.
# AGENT_BG_WAIT_CEILING_MS="${AGENT_BG_WAIT_CEILING_MS:-600000}"
# AGENT_BG_WAIT_CEILING_MS_IMPLEMENT="1800000"

# Phase settings. Each Claude phase is launched with a settings file the
# pipeline writes for that run (the phase's permission rules) and with
# --setting-sources, which chooses the settings layers read besides it.
# The default names all three, which is what the CLI does anyway. Set
# "project" so phases stop reading the operator's user settings (their allow
# rules, hooks, plugins and user-level skills): the pipeline then behaves the
# same on every machine. A plain AGENT_SETTING_SOURCES="" omits the flag.
# AGENT_SETTING_SOURCES="${AGENT_SETTING_SOURCES:-user,project,local}"
# A settings JSON of your own that every phase's file is built on (hooks,
# env, enabledPlugins, further permission rules). Absolute, or relative to
# this file's directory.
# AGENT_SETTINGS_FILE="${AGENT_SETTINGS_FILE:-}"
# Issues and pull requests the issue text refers to (#123) are pre-fetched
# into .agent-data/context/references/ for the phase to read. 0 turns it off.
# AGENT_CONTEXT_REFS_MAX="${AGENT_CONTEXT_REFS_MAX:-10}"

# Sandbox profile. "strict" runs each Claude phase under the sandbox runtime
# (srt): only the worktree is writable, credential stores are hidden, and the
# network reaches only the model provider, GitHub and the hosts you add.
# Default "none" (phases run as before). Per phase: AGENT_SANDBOX_<PHASE>.
# Needs srt, bubblewrap, socat and ripgrep: see docs/sandbox.md, and run
# scripts/check-prereqs.sh.
# AGENT_SANDBOX="${AGENT_SANDBOX:-none}"
# AGENT_SANDBOX_IMPLEMENT="strict"
# Path to srt when it is not on the dispatcher's PATH:
# AGENT_SANDBOX_SRT="${AGENT_SANDBOX_SRT:-}"
# Further hosts a sandboxed phase may reach (space- or comma-separated), for
# example a package registry:
# AGENT_SANDBOX_ALLOWED_DOMAINS="${AGENT_SANDBOX_ALLOWED_DOMAINS:-}"
# Further paths to hide from a sandboxed phase (a directory of tokens):
# AGENT_SANDBOX_DENY_READ="${AGENT_SANDBOX_DENY_READ:-}"
# Further paths a sandboxed phase may write (a build or package cache):
# AGENT_SANDBOX_ALLOW_WRITE="${AGENT_SANDBOX_ALLOW_WRITE:-}"
# Under "strict" a phase's Bash(...) prefix rules are replaced by one Bash
# rule, because the sandbox is what limits a command. "false" keeps the rules
# as written.
# AGENT_SANDBOX_SHORT_TOOLS="${AGENT_SANDBOX_SHORT_TOOLS:-true}"
# Let a sandboxed phase use Unix sockets, which a virtual display (Xvfb)
# needs. It weakens the profile; turn it on only for a repo that needs it.
# AGENT_SANDBOX_UNIX_SOCKETS="${AGENT_SANDBOX_UNIX_SOCKETS:-false}"
# A file holding a GitHub token for phases, exported to each phase as
# GH_TOKEN so it can read issues and pull requests with gh. Use a read-only
# fine-grained token; the dispatcher keeps every write. Only the path goes
# here, never the value.
# AGENT_PHASE_GH_TOKEN_FILE="${AGENT_PHASE_GH_TOKEN_FILE:-}"

# Phase environment. Phases are launched without the dispatcher's credentials
# (GH_TOKEN, GITHUB_TOKEN, AGENT_GIST_PAT, notification webhooks and bot tokens;
# full list in docs/security.md). Space-separated variable names.
# Remove further variables from every phase:
# AGENT_PHASE_SCRUB_ENV="${AGENT_PHASE_SCRUB_ENV:-}"
# Leave a variable in place for a project whose custom prompts need it. Keeping
# GH_TOKEN gives every phase a token that can push and write issues.
# AGENT_PHASE_KEEP_ENV="${AGENT_PHASE_KEEP_ENV:-}"

# Structured-output schemas per phase (default: the shipped schemas/*.json).
# Set to "" to disable a phase's schema; point at your own file if you
# customized that phase's prompt with a different output contract.
# AGENT_JSON_SCHEMA_TRIAGE=""
# AGENT_JSON_SCHEMA_POST_IMPL_REVIEW="my-schemas/review.json"

# Directory for dispatch locks and last-dispatch outcome records
# AGENT_LOCK_DIR="${AGENT_LOCK_DIR:-$AGENT_LOG_DIR/locks}"

# Extra directories phases may access unprompted, space-separated (--add-dir).
# Path gating is separate from tool allow rules: sibling repos, scratch
# areas, and package caches are denied without this even when the command
# matches an allow rule.
# AGENT_ADD_DIRS="${AGENT_ADD_DIRS:-}"

# Pre-PR test command (if set, tests must pass before PR creation)
# Examples:
# AGENT_TEST_COMMAND="${AGENT_TEST_COMMAND:-npm test}"
# AGENT_TEST_COMMAND="${AGENT_TEST_COMMAND:-pytest}"
# AGENT_TEST_COMMAND="${AGENT_TEST_COMMAND:-cargo test}"
# AGENT_TEST_COMMAND="${AGENT_TEST_COMMAND:-dotnet test}"

# ── Tool Permissions ─────────────────────────────────────────
# Claude tools allowed during triage/reply (read-only + Write for plan file)
AGENT_ALLOWED_TOOLS_TRIAGE="${AGENT_ALLOWED_TOOLS_TRIAGE:-Read,Write,Grep,Glob,Bash(echo:*),Bash(cat:*),Bash(ls:*),Bash(find:*)}"

# Claude tools allowed during implementation/review (read-write by default)
AGENT_ALLOWED_TOOLS_IMPLEMENT="${AGENT_ALLOWED_TOOLS_IMPLEMENT:-Read,Edit,Write,Grep,Glob,Bash(git add:*),Bash(git commit:*),Bash(git status),Bash(git diff:*),Bash(git log:*),Bash(ls:*),Bash(cat:*),Bash(grep:*),Bash(find:*),Bash(mkdir:*)}"

# Additional tools to append for project-specific needs
# Examples:
# AGENT_EXTRA_TOOLS="${AGENT_EXTRA_TOOLS:-Bash(npm:*),Bash(npx:*)}"
# AGENT_EXTRA_TOOLS="${AGENT_EXTRA_TOOLS:-Bash(cargo:*)}"
# AGENT_EXTRA_TOOLS="${AGENT_EXTRA_TOOLS:-Bash(dotnet:*)}"
# AGENT_EXTRA_TOOLS="${AGENT_EXTRA_TOOLS:-Bash(Godot:*),Bash(godot:*)}"

# ── Custom Prompts (optional, uses built-in defaults if unset) ──
# Point to your own prompt files to customize agent behavior
# AGENT_PROMPT_TRIAGE="${AGENT_PROMPT_TRIAGE:-/path/to/your/triage-prompt.md}"
# AGENT_PROMPT_IMPLEMENT="${AGENT_PROMPT_IMPLEMENT:-/path/to/your/implement-prompt.md}"
# AGENT_PROMPT_REPLY="${AGENT_PROMPT_REPLY:-/path/to/your/reply-prompt.md}"
# AGENT_PROMPT_REVIEW="${AGENT_PROMPT_REVIEW:-/path/to/your/review-prompt.md}"

# ── Adversarial Review Gates ─────────────────────────────────
# Pre-implementation plan review: fresh session checks plan against issue
# Set to "false" to disable
# AGENT_ADVERSARIAL_PLAN_REVIEW="${AGENT_ADVERSARIAL_PLAN_REVIEW:-true}"

# Post-implementation diff review: fresh session checks diff against issue/plan
# Set to "false" to disable
# AGENT_POST_IMPL_REVIEW="${AGENT_POST_IMPL_REVIEW:-true}"

# Max fix sessions in the capped review loop (review -> fix -> re-review).
# Each retry gets a fresh review pass against the previous pass's findings.
# 0 = single pass, no fix loop. Findings still outstanding when the cap is
# hit don't block the PR -- it opens anyway, annotated agent:review-unresolved
# (in addition to agent:pr-open), with the outstanding findings leading the
# PR body.
# AGENT_POST_IMPL_REVIEW_MAX_RETRIES="${AGENT_POST_IMPL_REVIEW_MAX_RETRIES:-3}"

# Max Claude fix sessions when the pre-PR test gate fails (0 = no fix
# sessions; the work branch is pushed either way, so nothing is lost)
# AGENT_TEST_GATE_MAX_RETRIES="${AGENT_TEST_GATE_MAX_RETRIES:-2}"

# Custom prompt files for review gates (uses built-in defaults if unset)
# AGENT_PROMPT_ADVERSARIAL_PLAN="${AGENT_PROMPT_ADVERSARIAL_PLAN:-/path/to/your/adversarial-plan.md}"
# AGENT_PROMPT_POST_IMPL_REVIEW="${AGENT_PROMPT_POST_IMPL_REVIEW:-/path/to/your/post-impl-review.md}"
# AGENT_PROMPT_POST_IMPL_RETRY="${AGENT_PROMPT_POST_IMPL_RETRY:-/path/to/your/post-impl-retry.md}"
# AGENT_PROMPT_TEST_FIX="${AGENT_PROMPT_TEST_FIX:-/path/to/your/test-fix.md}"

# ─── Post-merge cleanup phase ─────────────────────────────────────
# Runs after an agent PR merges: tracking-doc updates, follow-up issues
# from the review ledger, merged-branch deletion.
# AGENT_CLEANUP_ENABLED="${AGENT_CLEANUP_ENABLED:-true}"
# AGENT_PROMPT_CLEANUP="${AGENT_PROMPT_CLEANUP:-/path/to/your/cleanup.md}"
# Choose the cleanup engine/model in Worker selection above.
# AGENT_ALLOWED_TOOLS_CLEANUP="${AGENT_ALLOWED_TOOLS_CLEANUP:-}"  # see defaults.sh

# ── Legacy Model Fallback ─────────────────────────────────────
# Applies only to phases using the dispatch default engine, after explicit
# phase models and AGENT_MODEL_CLAUDE/AGENT_MODEL_CODEX. Empty = CLI default.
# Use Worker selection above for all per-phase engine/model settings.
# AGENT_MODEL="${AGENT_MODEL:-}"

# ── Notifications ────────────────────────────────────────────
# Notification level: "all" (every milestone), "actionable" (default, events
# needing user response), "failures" (only failures)
# AGENT_NOTIFY_LEVEL="${AGENT_NOTIFY_LEVEL:-actionable}"

# Backend: comma-separated list of "webhook" (Discord webhook), "bot" (Discord
# bot), "slack" (Slack bot). Empty = notifications disabled.
# Examples:
#   AGENT_NOTIFY_BACKEND="${AGENT_NOTIFY_BACKEND:-webhook}"
#   AGENT_NOTIFY_BACKEND="${AGENT_NOTIFY_BACKEND:-bot,slack}"
# AGENT_NOTIFY_BACKEND="${AGENT_NOTIFY_BACKEND:-}"

# Named dispatch profiles (optional; requires explicit AGENT_ENGINE_PROFILES=true).
# Incoming selector overrides saved .agent-profile, then config, then catalog default.
# AGENT_PROFILE="${AGENT_PROFILE:-}"
# Paths are relative to the effective CONFIG_DIR unless absolute.
# AGENT_PROFILES_FILE="${AGENT_PROFILES_FILE:-}"
# AGENT_PROFILE_STATE_FILE="${AGENT_PROFILE_STATE_FILE:-}"
